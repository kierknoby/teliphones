[Unit]
Description=TELIPHONES reference support gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
UMask=0077
StateDirectory=teliphones-gateway
StateDirectoryMode=0700
WorkingDirectory=/opt/teliphones-gateway
ExecStart=/usr/bin/python3 /opt/teliphones-gateway/teliphones_gateway.py --config /etc/teliphones-gateway.json --state-dir /var/lib/teliphones-gateway serve
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ReadWritePaths=/var/lib/teliphones-gateway

[Install]
WantedBy=multi-user.target