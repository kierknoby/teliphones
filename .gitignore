# Restored native dependencies
desktop/windows/vcpkg_installed/
desktop/windows/dependencies/
desktop/windows/build/
# Linux CMake build directory created by the portable test workflow.
desktop/windows/build-linux/

# Generated release/test artifacts belong in the external TELIPHONES archive,
# never at the repository root. Keep this root-scoped so packaged fixtures in
# source directories remain visible to Git.
/TELIPHONES-*.tgz
/TELIPHONES-*.tgz.sha256
/teliphones-history.bundle
/teliphones.com.zip
/teliphones.com.zip.sha256
