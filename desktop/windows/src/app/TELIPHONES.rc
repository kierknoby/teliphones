IDD_SSH_TERMINAL DIALOGEX 0, 0, 760, 500
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "TELIPHONES SSH Console"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Connecting", IDC_SSH_TERMINAL_STATUS, 12, 10, 736, 20
    EDITTEXT        IDC_SSH_TERMINAL_OUTPUT, 12, 43, 736, 392, ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    EDITTEXT        IDC_SSH_TERMINAL_INPUT, 12, 443, 650, 25, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "Send", IDC_SSH_TERMINAL_SEND, 670, 443, 78, 25
    PUSHBUTTON      "Copy All", IDC_SSH_TERMINAL_COPY, 252, 465, 78, 24
    PUSHBUTTON      "Clear All", IDC_SSH_TERMINAL_CLEAR, 337, 465, 78, 24
    PUSHBUTTON      "Paste", IDC_SSH_TERMINAL_PASTE, 422, 465, 78, 24
    PUSHBUTTON      "Reconnect", IDC_SSH_TERMINAL_RECONNECT, 507, 465, 78, 24
    PUSHBUTTON      "Disconnect", IDC_SSH_TERMINAL_DISCONNECT, 592, 465, 78, 24
    PUSHBUTTON      "Close", IDCANCEL, 677, 465, 71, 24
END
