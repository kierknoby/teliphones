    LTEXT           "", IDC_CONNECT_STATUS, 20, 212, 300, 58, SS_LEFT
    PUSHBUTTON      "Install WireGuard", IDC_CONNECT_INSTALL, 20, 278, 100, 20
    PUSHBUTTON      "Check Again", IDC_CONNECT_CHECK, 125, 278, 85, 20
    PUSHBUTTON      "Not Now", IDC_CONNECT_NOT_NOW, 215, 278, 100, 20
    PUSHBUTTON      "Add my PBX", IDC_SETUP_PBX, 65, 316, 100, 20
    PUSHBUTTON      "Remote Support", IDC_SETUP_SUPPORT, 175, 316, 100, 20
    GROUPBOX        "Security", IDC_PASSWORD_SECURITY_GROUP, 10, 338, 320, 42
    PUSHBUTTON      "Manage Password Protection...", IDC_CONNECT_PASSWORD, 20, 352, 215, 20
