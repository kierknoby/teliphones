#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "Version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TELIPHONES_VERSION_NUMERIC
 PRODUCTVERSION TELIPHONES_VERSION_NUMERIC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_PRERELEASE | VS_FF_DEBUG
#else
 FILEFLAGS VS_FF_PRERELEASE
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "FileDescription", "TELIPHONES Windows application\0"
            VALUE "FileVersion", TELIPHONES_VERSION_FILE_STRING "\0"
            VALUE "InternalName", "TELIPHONES\0"
            VALUE "OriginalFilename", "TELIPHONES.exe\0"
            VALUE "ProductName", "TELIPHONES\0"
            VALUE "ProductVersion", TELIPHONES_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0809, 1200
    END
END

IDD_MAIN DIALOGEX 0, 0, 620, 436
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME | WS_CLIPCHILDREN
CAPTION "TELIPHONES"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Saved connections", IDC_PBX_HEADING, 8, 28, 230, 15
    LTEXT           "Connection", IDC_CONNECTION_HEADING, 250, 28, 360, 15
    LTEXT           "WireGuard for Windows: checking...", IDC_WG_STATUS, 8, 8, 604, 14
    CONTROL         "", IDC_PROFILES, WC_LISTVIEW, WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL, 8, 48, 230, 110
    PUSHBUTTON      "Add my PBX...", IDC_ADD_PBX, 8, 164, 110, 20
    PUSHBUTTON      "Remote Support...", IDC_ADD_SUPPORT, 8, 190, 110, 20
    PUSHBUTTON      "Import grant...", IDC_UPDATE_GRANT, 128, 190, 110, 20
    PUSHBUTTON      "Remove", IDC_REMOVE, 128, 164, 110, 20
    LTEXT           "Remote Support session", IDC_SESSION_LABEL, 8, 216, 230, 14
    COMBOBOX        IDC_SESSION, 8, 234, 230, 100, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_DETAILS, 8, 256, 230, 32, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Lock to Current IP", IDC_LOCK_WORKSTATION, 8, 291, 230, 18
    LTEXT           "Allowed IPv4/IPv6/CIDR/DNS sources (comma-separated)", IDC_ALLOWED_SOURCES_LABEL, 8, 313, 230, 12
    EDITTEXT        IDC_ALLOWED_SOURCES, 8, 327, 230, 30, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Request Allowed List Change", IDC_REQUEST_SOURCES, 8, 361, 230, 20
    EDITTEXT        IDC_STATE, 250, 48, 360, 18, ES_READONLY | ES_AUTOHSCROLL
    PUSHBUTTON      "Pop Out", IDC_CONNECTION_HEALTH, 250, 290, 175, 20
    EDITTEXT        IDC_GUIDANCE, 250, 72, 360, 30, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_HEALTH_INLINE_TEXT, 250, 108, 360, 62, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    CONTROL         "", IDC_HEALTH_INLINE_GRAPH, "Static", SS_OWNERDRAW, 250, 202, 360, 80
    COMBOBOX        IDC_HEALTH_INLINE_HISTORY, 250, 178, 90, 70, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_HEALTH_PLOT, 348, 178, 262, 70, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "View Session Log", IDC_SESSION_LOG, 435, 290, 175, 20
    PUSHBUTTON      "Connect", IDC_CONNECT, 8, 388, 95, 18
    PUSHBUTTON      "Disconnect", IDC_DISCONNECT, 109, 388, 95, 18
    PUSHBUTTON      "Open FreePBX", IDC_OPEN_GUI, 210, 388, 95, 18
    PUSHBUTTON      "Open SSH", IDC_OPEN_SSH, 311, 388, 95, 18
    PUSHBUTTON      "Settings...", IDC_SETTINGS, 412, 388, 95, 18
    DEFPUSHBUTTON   "Close", IDCANCEL, 513, 388, 95, 18
    CONTROL         "", IDC_PRODUCT_FOOTER, "Static", SS_CENTER | SS_CENTERIMAGE | SS_ENDELLIPSIS, 8, 410, 604, 18
END

IDD_CONNECTION_HEALTH DIALOGEX 0, 0, 360, 240
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "TELIPHONES Connection Health"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Health: Unknown", IDC_HEALTH_STATE, 8, 8, 344, 12, SS_LEFT
    LTEXT           "Authorization: Unknown", IDC_HEALTH_AUTH, 8, 23, 344, 12, SS_LEFT
    LTEXT           "TCP RTT: Unknown   Jitter: Unknown", IDC_HEALTH_LATENCY, 8, 38, 344, 12, SS_LEFT
    LTEXT           "App probes: Unknown", IDC_HEALTH_PROBES, 8, 53, 344, 12, SS_LEFT
    LTEXT           "Rx Unknown   Tx Unknown   Handshake Unknown", IDC_HEALTH_TRAFFIC, 8, 68, 344, 12, SS_LEFT
    CONTROL         "", IDC_HEALTH_GRAPH, "Static", SS_OWNERDRAW, 8, 86, 344, 92
    LTEXT           "Probes are not packet loss; rates are not bandwidth capacity.", IDC_HEALTH_WARNING, 8, 180, 344, 24, SS_LEFT
    COMBOBOX        IDC_HEALTH_HISTORY, 8, 207, 75, 70, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_HEALTH_POP_PLOT, 88, 207, 264, 70, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Always on Top", IDC_HEALTH_TOPMOST, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 225, 110, 12
    PUSHBUTTON      "Limits...", IDC_HEALTH_THRESHOLDS, 282, 222, 70, 16
END

IDD_SESSION_LOG DIALOGEX 0, 0, 540, 350
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "TELIPHONES Session Log"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Local diagnostics (redacted). Export saves this same snapshot as UTF-8.", -1, 8, 8, 524, 14
    EDITTEXT        IDC_SESSION_LOG_TEXT, 8, 26, 524, 286, ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON      "Export...", IDC_SESSION_LOG_EXPORT, 372, 322, 75, 20
    DEFPUSHBUTTON   "Close", IDOK, 457, 322, 75, 20
END

IDD_HEALTH_LIMITS DIALOGEX 0, 0, 205, 105
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Connection Health Thresholds"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Warn latency:", -1, 8, 10, 82, 14
    COMBOBOX        IDC_HEALTH_LIMIT_LATENCY, 96, 7, 100, 65, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Warn jitter:", -1, 8, 34, 82, 14
    COMBOBOX        IDC_HEALTH_LIMIT_JITTER, 96, 31, 100, 65, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Unstable after:", -1, 8, 58, 82, 14
    COMBOBOX        IDC_HEALTH_LIMIT_FAILURES, 96, 55, 100, 65, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "Save", IDOK, 78, 79, 55, 18
    PUSHBUTTON      "Cancel", IDCANCEL, 139, 79, 58, 18
END

IDD_PAIR DIALOGEX 0, 0, 445, 394
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Pair my PBX"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX        "Request access", -1, 10, 7, 425, 207
    LTEXT           "&Workstation name:", -1, 20, 24, 95, 14
    EDITTEXT        IDC_PAIR_WORKSTATION, 120, 22, 305, 18, ES_AUTOHSCROLL
    LTEXT           "&Access requested:", -1, 20, 48, 95, 14
    COMBOBOX        IDC_PAIR_ACCESS, 120, 46, 305, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Generate request", IDC_PAIR_GENERATE, 20, 72, 95, 22
    LTEXT           "Copy into Connectivity > TELIPHONES > Pair a Workstation in FreePBX.", -1, 125, 73, 300, 25
    LTEXT           "Generated pairing &request:", -1, 20, 101, 405, 14
    EDITTEXT        IDC_PAIR_REQUEST, 20, 117, 405, 56, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    PUSHBUTTON      "&Copy request", IDC_PAIR_COPY, 20, 181, 90, 22, WS_DISABLED
    LTEXT           "", IDC_PAIR_FINGERPRINT, 120, 182, 305, 25, SS_LEFT
    GROUPBOX        "Complete pairing", -1, 10, 223, 425, 113
    LTEXT           "&Paste the response produced by the PBX:", -1, 20, 240, 405, 14
    EDITTEXT        IDC_PAIR_RESPONSE, 20, 257, 405, 46, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_DISABLED
    LTEXT           "SSH account approved by FreePBX:", IDC_PAIR_SSHLABEL, 20, 313, 240, 14, NOT WS_VISIBLE
    EDITTEXT        IDC_PAIR_SSHUSER, 265, 309, 160, 18, ES_AUTOHSCROLL | ES_READONLY | NOT WS_VISIBLE
    LTEXT           "", IDC_PAIR_STATUS, 10, 343, 425, 25, SS_LEFT
    DEFPUSHBUTTON   "&Save connection", IDOK, 265, 371, 90, 20, WS_DISABLED
    PUSHBUTTON      "Cancel", IDCANCEL, 360, 371, 75, 20
END

IDD_SUPPORT DIALOGEX 0, 0, 445, 310
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Remote Support"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Profile name:", -1, 10, 12, 80, 14
    EDITTEXT        IDC_SUP_NAME, 95, 10, 245, 18, ES_AUTOHSCROLL
    PUSHBUTTON      "Generate engineer key", IDC_SUP_GENERATE, 10, 38, 135, 22
    PUSHBUTTON      "Copy public key", IDC_SUP_COPY, 150, 38, 100, 22
    EDITTEXT        IDC_SUP_PUBKEY, 10, 66, 425, 35, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    LTEXT           "", IDC_SUP_HINT, 10, 108, 425, 42, SS_LEFT
    LTEXT           "Current grant:", -1, 10, 157, 90, 14
    EDITTEXT        IDC_SUP_GRANT, 10, 176, 325, 44, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    PUSHBUTTON      "Import grant...", IDC_SUP_BROWSE, 345, 176, 90, 22
    LTEXT           "The private key remains in Windows Credential Manager. Share only the public key with your gateway operator.", -1, 10, 230, 425, 28, SS_LEFT
    DEFPUSHBUTTON   "Save", IDOK, 265, 276, 80, 22
    PUSHBUTTON      "Cancel", IDCANCEL, 355, 276, 80, 22
END

