IDD_CONNECT_PASSWORD_CHOICE DIALOGEX 0, 0, 350, 148
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Password Protection"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Choose how TELIPHONES stores this connection's key. Password Protection is required on every Connect.", IDC_PASSWORD_CHOICE_NOTICE, 10, 10, 330, 40, SS_LEFT
    DEFPUSHBUTTON   "Set Password", IDC_PASSWORD_SET, 10, 68, 105, 24
    PUSHBUTTON      "Skip This Time", IDC_PASSWORD_SKIP_ONCE, 122, 68, 105, 24
    PUSHBUTTON      "Skip Permanently", IDC_PASSWORD_SKIP_ALWAYS, 234, 68, 106, 24
    PUSHBUTTON      "Cancel", IDCANCEL, 270, 116, 70, 20
END

IDD_CONNECT_PASSWORD DIALOGEX 0, 0, 330, 158
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
